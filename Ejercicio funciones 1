package main

import (
	"fmt"
	"strings"
)



func main() {
	var opcion string

	for {
		fmt.Println("\n--- MENÚ ---")
		fmt.Println("1. Promedio de curso")
		fmt.Println("2. Suma de 1 a n")
		fmt.Println("3. Celsius a Fahrenheit")
		fmt.Println("4. Fahrenheit a Celsius")
		fmt.Println("0. Salir")
		fmt.Print("Elige: ")

		fmt.Scan(&opcion)
		opcion = strings.ToLower(opcion)

		if opcion == "0" || opcion == "salir" {
			break
		}

		switch opcion {
		case "1":
			opcion1()
		case "2":
			opcion2()
		case "3":
			opcion3()
		case "4":
			opcion4()
		default:
			fmt.Println("Opción inválida.")
		}666
	}
}

func opcion1() {
	var cantidad int
	fmt.Print("Cantidad de estudiantes: ")
	fmt.Scan(&cantidad)

	notas := make([]float64, cantidad)
	for i := 0; i < cantidad; i++ {
		fmt.Printf("Nota del estudiante %d: ", i+1)
		fmt.Scan(&notas[i])
	}

	promedio := averageGrade(notas)
	fmt.Printf("Promedio: %.2f\n", promedio)

	if promedio >= 70 {
		fmt.Println("Aprobado")
	} else {
		fmt.Println("Reprobado")
	}

	
	switch {
	case promedio >= 90:
		fmt.Println("Excellent performance")
	case promedio >= 80:
		fmt.Println("Good performance")
	case promedio >= 70:
		fmt.Println("Satisfactory performance")
	default:
		fmt.Println("Needs improvement")
	}
}

func averageGrade(notas []float64) float64 {
	suma := 0.0
	for _, n := range notas {
		suma += n
	}
	return suma / float64(len(notas))
}

func opcion2() {
	var n, suma int
	fmt.Print("Ingresa n: ")
	fmt.Scan(&n)
	for i := 1; i <= n; i++ {
		suma += i
	}
	fmt.Println("Suma total:", suma)
}

func opcion3() {
	var c float64
	fmt.Print("Grados Celsius: ")
	fmt.Scan(&c)
	fmt.Printf("Fahrenheit: %.2f\n", (c*9/5)+32) 
}

func opcion4() {
	var f float64
	fmt.Print("Grados Fahrenheit: ")
	fmt.Scan(&f)
	fmt.Printf("Celsius: %.2f\n", (f-32)*5/9) 
}