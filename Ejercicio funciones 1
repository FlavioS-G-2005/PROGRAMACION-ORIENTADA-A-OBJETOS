package main

import (
	"fmt"
	"strings"
)

// Proyecto: Menú de Opciones en Go
// Autores: Flavio y Alex
// Universidad Internacional del Ecuador (UIDE) - Ingeniería en Sistemas

func main() {
	var opcion string

	// Bucle infinito para mantener el menú activo hasta que se elija salir
	for {
		fmt.Println("\n--- MENÚ PRINCIPAL ---")
		fmt.Println("1. Calcular promedio de estudiantes")
		fmt.Println("2. Suma de 1 al número n")
		fmt.Println("3. Convertir Celsius a Fahrenheit")
		fmt.Println("4. Convertir Fahrenheit a Celsius")
		fmt.Println("0 o 'salir' para terminar")
		fmt.Print("Elige una opción: ")

		fmt.Scan(&opcion)
		opcion = strings.ToLower(opcion) // Convertir a minúsculas por si escribes "SALIR"

		// Condición de salida
		if opcion == "0" || opcion == "salir" {
			fmt.Println("Saliendo del programa...")
			break
		}

		// Evaluamos la opción elegida
		switch opcion {
		case "1":
			ejecutarOpcion1()
		case "2":
			ejecutarOpcion2()
		case "3":
			ejecutarOpcion3()
		case "4":
			ejecutarOpcion4()
		default:
			fmt.Println("Opción no válida. Intenta de nuevo.")
		}
	}
}

// Opción 1: Notas de estudiantes
func ejecutarOpcion1() {
	var cantidad int
	fmt.Print("Ingresa la cantidad de estudiantes del curso: ")
	fmt.Scan(&cantidad)

	if cantidad <= 0 {
		fmt.Println("La cantidad debe ser mayor a 0.")
		return
	}

	// Creamos un arreglo (slice) para guardar las notas
	notas := make([]float64, cantidad)
	
	for i := 0; i < cantidad; i++ {
		fmt.Printf("Ingresa la nota (0 a 100) del estudiante %d: ", i+1)
		fmt.Scan(&notas[i])
	}

	// Llamamos a la función que calcula el promedio
	promedio := averageGrade(notas)
	fmt.Printf("\nEl promedio del curso es: %.2f\n", promedio)

	// Condicional simple para aprobar o reprobar
	if promedio >= 70 {
		fmt.Println("Estado: APROBADO")
	} else {
		fmt.Println("Estado: REPROBADO")
	}

	// Switch para los rangos de rendimiento
	switch {
	case promedio >= 90 && promedio <= 100:
		fmt.Println("Rendimiento: Excellent performance")
	case promedio >= 80 && promedio < 90:
		fmt.Println("Rendimiento: Good performance")
	case promedio >= 70 && promedio < 80:
		fmt.Println("Rendimiento: Satisfactory performance")
	default:
		fmt.Println("Rendimiento: Needs improvement")
	}
}

// Función requerida para calcular el promedio
func averageGrade(notas []float64) float64 {
	suma := 0.0
	for _, nota := range notas {
		suma += nota
	}
	return suma / float64(len(notas))
}

// Opción 2: Suma de 1 a n
func ejecutarOpcion2() {
	var n int
	fmt.Print("Ingresa un número (n) para sumar del 1 a n: ")
	fmt.Scan(&n)

	suma := 0
	for i := 1; i <= n; i++ {
		suma += i
	}
	fmt.Printf("La suma de números del 1 al %d es: %d\n", n, suma)
}

// Opción 3: Celsius a Fahrenheit
func ejecutarOpcion3() {
	var c float64
	fmt.Print("Ingresa la temperatura en Celsius: ")
	fmt.Scan(&c)
	f := (c * 9 / 5) + 32
	fmt.Printf("%.2f °C equivale a %.2f °F\n", c, f)
}

// Opción 4: Fahrenheit a Celsius
func ejecutarOpcion4() {
	var f float64
	fmt.Print("Ingresa la temperatura en Fahrenheit: ")
	fmt.Scan(&f)
	c := (f - 32) * 5 / 9
	fmt.Printf("%.2f °F equivale a %.2f °C\n", f, c)
}